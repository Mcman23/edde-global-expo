# Supabase Public Credentials (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-ONLY: Never expose to the client or public repos)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# EDDE Global WhatsApp Contact Number (International E.164 format without + or spaces, e.g., 447000000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=447000000000

# Application Public Base URL
NEXT_PUBLIC_APP_URL=https://expo.eddeglobal.com
